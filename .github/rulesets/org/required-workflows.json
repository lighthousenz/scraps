{
  "name": "scraps: Required Workflows From Main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": ["scraps"],
      "exclude": [],
      "protected": false
    },
    "ref_name": {
      "include": ["~DEFAULT_BRANCH", "refs/heads/epic/*", "refs/heads/epic/**/*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": true,
        "workflows": [
          {
            "path": ".github/workflows/ci.yml",
            "repository_id": 1442537354,
            "ref": "refs/heads/main"
          },
          {
            "path": ".github/workflows/commits.yml",
            "repository_id": 1442537354,
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ],
  "bypass_actors": []
}
